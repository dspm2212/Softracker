<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task: MonitoreoCaptura
  Runs agente_captura.exe every 10 minutes while the student session is active.

  Key behaviors:
    - Fires 5 minutes after login (delay avoids capturing Windows autostart noise).
    - Repeats every 10 minutes indefinitely until the session ends.
    - IgnoreNew: if a capture is still running when the next trigger fires, skip it.
    - No console window (compiled with --noconsole).
    - Execution time limit: 3 minutes (a capture takes < 5 seconds normally).

  Placeholders replaced by instalar.ps1:
    __INSTALL_USER__  → DOMAIN\estudiante
    __INSTALL_DIR__   → C:\monitoreo  (or custom InstallDir)
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">

  <RegistrationInfo>
    <Author>Daniel Perez</Author>
    <Description>Capture active applications every 10 min for the logged-in user.</Description>
    <URI>\Monitoreo\Captura</URI>
  </RegistrationInfo>

  <Triggers>
    <LogonTrigger>
      <!--
        5-minute delay after login so that Windows autostart apps
        (OneDrive, Teams, antivirus updates, etc.) are not captured as
        student usage. The 10-minute repetition starts after this delay.
      -->
      <Delay>PT5M</Delay>
      <Repetition>
        <Interval>PT10M</Interval>
        <!-- No Duration element = repeat indefinitely until session ends -->
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!--
        Task only runs when the student is the interactive user.
        instalar.ps1 replaces __INSTALL_USER__ with DOMAIN\estudiante.
        If admin logs in, this task does NOT fire (InteractiveToken check).
      -->
      <UserId>__INSTALL_USER__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <!-- Do not start a new instance if the previous one is still running -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <WakeToRun>false</WakeToRun>
    <!-- A missed trigger (PC off) is skipped; agente_retry handles orphan data -->
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <!-- Kill the task if it runs longer than 3 minutes (should never happen) -->
    <ExecutionTimeLimit>PT3M</ExecutionTimeLimit>
    <Priority>7</Priority>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>__INSTALL_DIR__\agente_captura.exe</Command>
      <WorkingDirectory>__INSTALL_DIR__</WorkingDirectory>
    </Exec>
  </Actions>

</Task>
