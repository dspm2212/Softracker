<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task: MonitoreoArranque
  Runs agente_retry.exe once at session start (login).

  Key behaviors:
    - Fires immediately on login (no delay): at startup we want to catch up
      on missed sends from previous sessions as quickly as possible.
    - No repetition: runs exactly once per login.
    - Covers the case where the PC was off at 21:45 (agente_envio missed):
        1. Finds orphan JSONLs in raw/ (no matching Parquet anywhere).
        2. Consolidates each orphan → pendientes/.
        3. Sends all pending Parquets to the API.
    - IgnoreNew: prevents double-run if the user logs off and on quickly.
    - No console window (compiled with --noconsole).
    - ExecutionTimeLimit: 15 minutes — enough to consolidate + upload
      several days of backlogged data over a slow connection.

  Placeholders replaced by instalar.ps1:
    __INSTALL_USER__  → DOMAIN\estudiante
    __INSTALL_DIR__   → C:\monitoreo  (or custom InstallDir)
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">

  <RegistrationInfo>
    <Author>Daniel Perez</Author>
    <Description>Consolidate orphan data and retry pending uploads at session start.</Description>
    <URI>\Monitoreo\Arranque</URI>
  </RegistrationInfo>

  <Triggers>
    <LogonTrigger>
      <!--
        No Delay and no Repetition: runs once, as soon as the user logs in.
        Catching up on missed sends should happen at the earliest opportunity.
      -->
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!--
        Task only runs when the student is the interactive user.
        instalar.ps1 replaces __INSTALL_USER__ with DOMAIN\estudiante.
        If admin logs in, this task does NOT fire (InteractiveToken check).
      -->
      <UserId>__INSTALL_USER__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <!-- Do not start a new instance if already running (fast re-login edge case) -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <WakeToRun>false</WakeToRun>
    <!--
      StartWhenAvailable=false: if this trigger is somehow missed, skip it.
      The same recovery will run on the next login.
    -->
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <!-- Kill the task if it runs longer than 15 minutes -->
    <ExecutionTimeLimit>PT15M</ExecutionTimeLimit>
    <Priority>7</Priority>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>__INSTALL_DIR__\agente_retry.exe</Command>
      <WorkingDirectory>__INSTALL_DIR__</WorkingDirectory>
    </Exec>
  </Actions>

</Task>
