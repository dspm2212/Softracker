<?xml version="1.0" encoding="UTF-16"?>
<!--
  tarea_programada.xml
  Windows Task Scheduler definition for the Softracker monitoring agent.

  Behaviour:
    - Triggers once when the 'estudiante' user logs in (with a 1-minute
      delay to let the desktop settle).
    - Runs monitor.py as a persistent background process (no window).
    - No repetition trigger is needed because the Python agent loops
      internally, polling every poll_interval seconds.
    - Execution time limit is set to zero (PT0S) so the process is not
      killed mid-session.

  Import with (run as Administrator):
    schtasks /create /tn "\Universidad\SoftrackerMonitor" ^
             /xml "C:\monitoreo\tarea_programada.xml" /f

  Manual test run:
    schtasks /run /tn "\Universidad\SoftrackerMonitor"

  Author: Daniel Santiago Perez Madera <dsperezm@udistrital.edu.co>
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">

  <RegistrationInfo>
    <Description>Softracker: monitors running applications and active usage time</Description>
    <Author>Universidad</Author>
    <URI>\Universidad\SoftrackerMonitor</URI>
  </RegistrationInfo>

  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>estudiante</UserId>
      <!-- Wait 1 minute after login before starting the agent -->
      <Delay>PT1M</Delay>
    </LogonTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!-- Run as the logged-in user (least privilege) -->
      <GroupId>S-1-5-32-545</GroupId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <!-- No time limit: the agent is a long-running background process -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <!-- pythonw runs without a console window -->
      <Command>pythonw</Command>
      <Arguments>C:\monitoreo\monitor.py</Arguments>
      <WorkingDirectory>C:\monitoreo</WorkingDirectory>
    </Exec>
  </Actions>

</Task>
