# =============================================================
# api.env.example
# Environment variables for the Softracker ingestion API.
#
# Copy to /etc/monitoreo_salas/api.env and restrict permissions:
#   sudo cp systemd/api.env.example /etc/monitoreo_salas/api.env
#   sudo chown root:monitoreo /etc/monitoreo_salas/api.env
#   sudo chmod 640 /etc/monitoreo_salas/api.env
#
# Then edit the file and set a strong DB_PASSWORD before
# starting the service.
#
# Author: Daniel Santiago Perez Madera <dsperezm@udistrital.edu.co>
# =============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=universidad
DB_USER=monitor_apps_rw
DB_PASSWORD=change_me_strong_password
DB_SCHEMA=monitoreo_apps

# Set to DEBUG for verbose output during initial deployment
LOG_LEVEL=INFO
